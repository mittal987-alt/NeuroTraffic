# ──────────────────────────────────────────────
# TrafficVision AI - Environment Variables
# ──────────────────────────────────────────────

# --- Database ---
# Local SQLite default (or Postgres connection string)
DATABASE_URL=sqlite:///./traffic.db

# --- Authentication & Authorization ---
JWT_SECRET_KEY=your-super-secret-jwt-key-here
ADMIN_EMAILS=admin@trafficvision.ai,chief@police.gov.in

# --- Signal Operation Mode ---
# "simulated" (default cycle) | "manual" (admin POST /signals/{id}/state) | "api"
SIGNAL_MODE=simulated
SIGNAL_API_URL=https://api.traffic-controller.local/signal/state

# --- Privacy & Data Retention (DPDP Act) ---
ENABLE_FACE_CAPTURE=false
FACE_RETENTION_DAYS=7

# --- False-Positive Reduction ---
CONSECUTIVE_VIOLATION_CHECKS=3

# --- Detection Tuning ---
CONF_THRESHOLD=0.4
DETECTION_FRAME_SKIP=4
WHOLE_FRAME_CHECK_INTERVAL=30
SPEED_LIMIT_KMH=80.0
PIXELS_PER_METER=8.0
LINE_Y=240
JPEG_QUALITY=60
DETECTION_RESIZE_WIDTH=640

# --- Camera Sources ---
CAMERA_1_VIDEO_PATH=traffic.mp4

# --- External Cloud & Notification Services ---
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FCM_DEVICE_TOKEN=PASTE_YOUR_FCM_TOKEN_HERE
ROBOFLOW_API_KEY=your-roboflow-api-key
